# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Connection URI)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/shopkart?retryWrites=true&w=majority

# Authentication
# Strong random secret string used to sign JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS and cookie verification)
FRONTEND_URL=https://your-frontend-deployment.vercel.app

# Razorpay Test Mode Credentials
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
